From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: strain08 <117145406+strain08@users.noreply.github.com>
Date: Wed, 3 Jun 2026 05:10:36 +0300
Subject: [PATCH 2/7] freebsd: fix uname parsing

FreeBSD's uname -sm returns "FreeBSD amd64"
---
 crates/remote/src/transport.rs | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/crates/remote/src/transport.rs b/crates/remote/src/transport.rs
index 6e8a68f9b2..10653f6d2a 100644
--- a/crates/remote/src/transport.rs
+++ b/crates/remote/src/transport.rs
@@ -45,7 +45,7 @@ fn parse_platform(output: &str) -> Result<RemotePlatform> {
         || arch.starts_with("aarch64")
     {
         RemoteArch::Aarch64
-    } else if arch.starts_with("x86") {
+    } else if arch.starts_with("x86") || arch == "amd64" {
         RemoteArch::X86_64
     } else {
         anyhow::bail!(
@@ -444,6 +444,14 @@ mod tests {
         assert_eq!(result.os, RemoteOs::Linux);
         assert_eq!(result.arch, RemoteArch::X86_64);
 
+        let result = parse_platform("FreeBSD amd64\n").unwrap();
+        assert_eq!(result.os, RemoteOs::FreeBsd);
+        assert_eq!(result.arch, RemoteArch::X86_64);
+
+        let result = parse_platform("FreeBSD aarch64\n").unwrap();
+        assert_eq!(result.os, RemoteOs::FreeBsd);
+        assert_eq!(result.arch, RemoteArch::Aarch64);
+
         assert!(parse_platform("Windows x86_64\n").is_err());
         assert!(parse_platform("Linux armv7l\n").is_err());
     }
